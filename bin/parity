#!/usr/bin/env sh
# Runs the parity CLI: a published single-file binary if present, else the debug build via dotnet.
set -e
here="$(cd "$(dirname "$0")/.." && pwd)"
if [ -x "$here/dist/parity" ]; then exec "$here/dist/parity" "$@"; fi
bin="$here/src/Parity/bin/Debug/net10.0/parity.dll"
if [ ! -f "$bin" ]; then dotnet build "$here/src/Parity" -nologo -v q >/dev/null; fi
exec dotnet "$bin" "$@"
